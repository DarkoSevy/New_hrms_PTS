# PostgreSQL connection string
DATABASE_URL="postgresql://hrms:hrms_dev_pw@127.0.0.1:5432/pts_hrms?schema=public"

# API server
PORT=4000
NODE_ENV=development

# CORS — comma separated list of allowed web origins
WEB_ORIGIN="http://localhost:5173"

# JWT secrets (generate strong random values in production, e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-fedcba9876543210"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# bcrypt work factor
BCRYPT_ROUNDS=12

# File uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=15

# Seed admin bootstrap password (used only by prisma/seed.ts)
SEED_DEFAULT_PASSWORD="Passw0rd!"
